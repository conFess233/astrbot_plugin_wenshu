{
  "enabled": {
    "type": "bool",
    "description": "启用文枢",
    "default": true
  },
  "detect_provider": {
    "type": "string",
    "description": "意图检测 provider ID",
    "default": ""
  },
  "generate_provider": {
    "type": "string",
    "description": "文案生成 provider ID",
    "default": ""
  },
  "search_mode": {
    "type": "string",
    "description": "联网搜索模式",
    "default": "required",
    "options": [
      "required",
      "auto",
      "off"
    ],
    "hint": "必须搜索／模型按需／关闭，服务商与凭证复用消息所属会话的有效配置"
  },
  "failure_policy": {
    "type": "string",
    "description": "失败策略",
    "default": "stop",
    "options": [
      "stop",
      "grounded",
      "passthrough"
    ],
    "hint": "提示并结束／使用可靠知识库资料降级／交回普通聊天（可能调用主模型）"
  },
  "persona_mode": {
    "type": "string",
    "description": "写作人格",
    "default": "current",
    "options": [
      "current",
      "specified",
      "none"
    ]
  },
  "persona_id": {
    "type": "string",
    "description": "指定人格 ID",
    "default": ""
  },
  "kb_ids": {
    "type": "list",
    "description": "知识库 ID",
    "default": [],
    "hint": "空列表关闭检索，文档管理仍在宿主知识库页面"
  },
  "group_scope": {
    "type": "string",
    "description": "群聊检测范围",
    "default": "wake",
    "options": [
      "wake",
      "all"
    ],
    "hint": "wake 跟随宿主唤醒条件；all 监听所有群消息，可能增加费用"
  },
  "max_concurrency": {
    "type": "int",
    "description": "全局最大并发任务",
    "default": 2,
    "hint": "允许 1～16；运行记录设为 0 不保留摘要"
  },
  "history_messages": {
    "type": "int",
    "description": "只读历史最大条数",
    "default": 12,
    "hint": "允许 0～50；运行记录设为 0 不保留摘要"
  },
  "history_chars": {
    "type": "int",
    "description": "只读历史最大字符数",
    "default": 8000,
    "hint": "允许 0～30000；运行记录设为 0 不保留摘要"
  },
  "max_tool_calls": {
    "type": "int",
    "description": "每任务工具调用上限",
    "default": 8,
    "hint": "允许 1～30；运行记录设为 0 不保留摘要"
  },
  "task_timeout": {
    "type": "int",
    "description": "任务总时限（秒）",
    "default": 180,
    "hint": "允许 15～600；运行记录设为 0 不保留摘要"
  },
  "record_limit": {
    "type": "int",
    "description": "摘要最多保留条数",
    "default": 200,
    "hint": "允许 0～1000；运行记录设为 0 不保留摘要"
  },
  "presets": {
    "type": "template_list",
    "description": "文案预设",
    "default": [],
    "templates": {
      "preset": {
        "name": "文案预设",
        "items": {
          "id": {
            "type": "string",
            "description": "稳定 ID（字母数字下划线连字符）",
            "default": ""
          },
          "name": {
            "type": "string",
            "description": "名称",
            "default": "新预设"
          },
          "description": {
            "type": "text",
            "description": "说明",
            "default": ""
          },
          "enabled": {
            "type": "bool",
            "description": "启用",
            "default": false
          },
          "priority": {
            "type": "int",
            "description": "优先级（越大越优先，同级按列表顺序）",
            "default": 0
          },
          "keywords": {
            "type": "list",
            "description": "关键词（任一命中）",
            "default": []
          },
          "patterns": {
            "type": "list",
            "description": "正则列表（任一命中）",
            "default": []
          },
          "intent": {
            "type": "text",
            "description": "意图判定说明",
            "default": ""
          },
          "prompt": {
            "type": "text",
            "description": "完整生成要求",
            "default": ""
          },
          "example": {
            "type": "text",
            "description": "完整范文（不作为事实证据）",
            "default": ""
          },
          "opening": {
            "type": "string",
            "description": "固定开头（空表示不检查）",
            "default": ""
          },
          "paragraphs": {
            "type": "int",
            "description": "正文段落数（0 表示不检查）",
            "default": 0
          },
          "overrides": {
            "type": "dict",
            "description": "预设覆盖（推荐使用文枢管理页面）",
            "default": {},
            "hint": "省略字段继承；kb_ids=[] 显式关闭知识库，不用空字符串代替继承"
          },
          "mode": {
            "type": "string",
            "description": "执行模式",
            "default": "generate",
            "options": [
              "generate",
              "direct",
              "detect_only"
            ],
            "hint": "检索生成／规则命中直接发送固定文案（不调用模型）／只判定意图后发送固定文案（仅调用检测模型）"
          },
          "reply": {
            "type": "text",
            "description": "固定文案（原样发送）",
            "default": "",
            "hint": "direct 和 detect_only 使用；不搜索、不生成、不替换变量，最多 30000 字符"
          }
        }
      }
    }
  }
}
